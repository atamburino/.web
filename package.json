{
	"name": "web-template",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"build:standalone": "vite build --mode standalone",
		"preview": "vite preview",
		"preview:standalone": "vite build --mode standalone && vite preview --mode standalone",
		"typecheck": "tsc -b",
		"lint": "eslint . --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"api:pull": "node scripts/pull-spec.ts",
		"api:gen": "node scripts/gen-api.ts",
		"new:feature": "node scripts/new-feature.ts",
		"init:app": "node scripts/init.ts"
	},
	"dependencies": {
		"@fontsource-variable/geist": "5.3.0",
		"@reduxjs/toolkit": "2.13.0",
		"@tanstack/react-router": "1.170.42",
		"class-variance-authority": "0.7.1",
		"cn": "0.4.0",
		"lucide-react": "1.55.0",
		"motion": "14.1.0",
		"radix-ui": "1.7.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-redux": "9.3.0",
		"tw-animate-css": "1.4.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@babel/core": "8.0.7",
		"@eslint/js": "10.0.1",
		"@hey-api/openapi-ts": "0.99.0",
		"@rolldown/plugin-babel": "0.2.4",
		"@rtk-query/codegen-openapi": "2.2.0",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/router-cli": "1.167.41",
		"@tanstack/router-plugin": "1.168.43",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"@vitest/browser-playwright": "5.0.3",
		"babel-plugin-react-compiler": "1.0.0",
		"eslint": "10.12.0",
		"eslint-plugin-better-tailwindcss": "4.9.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-react-hooks": "7.1.1",
		"globals": "17.13.0",
		"msw": "3.0.3",
		"playwright": "1.64.0",
		"prettier": "3.9.10",
		"prettier-plugin-tailwindcss": "0.8.1",
		"shadcn": "4.21.4",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1",
		"vite": "8.3.4",
		"vitest": "5.0.3",
		"vitest-browser-react": "2.3.0"
	}
}
